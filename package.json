{
  "name": "@d1vai/openxiangqi-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript/JavaScript SDK for OpenXiangqi (中国象棋开放云中台)",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "xiangqi",
    "chinese-chess",
    "chess",
    "sdk",
    "d1vai",
    "multi-tenant",
    "web3",
    "game-backend"
  ],
  "author": "d1vai",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
